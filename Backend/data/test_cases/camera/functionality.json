    {
      "test_case_id": "TC_CAM_FUNC_001",
      "feature": "Camera",
      "test_type": "Functional",
      "test_name": "Rear Primary Camera Photo Capture",
      "execution": "AUTO",
      "objective": "Validate that the rear primary camera can successfully capture and save a photo using the device-supported configuration.",
      "applicability": {
        "required_capabilities": [
          "${REAR_PRIMARY_CAMERA}",
          "${REAR_PRIMARY_PHOTO_RESOLUTION}"
        ],
        "condition": "${REAR_PRIMARY_CAMERA_SUPPORTED} == true",
        "not_applicable_if": "${REAR_PRIMARY_CAMERA_SUPPORTED} == false"
      },
      "parameters": {
        "camera": "${REAR_PRIMARY_CAMERA}",
        "camera_id": "${REAR_PRIMARY_CAMERA_ID}",
        "photo_resolution": "${REAR_PRIMARY_PHOTO_RESOLUTION}",
        "image_format": "${DEFAULT_IMAGE_FORMAT}"
      },
      "prerequisites": [
        "ADB connection is available",
        "Camera permission is granted",
        "${REAR_PRIMARY_CAMERA} is available",
        "Available storage is greater than ${MIN_FREE_STORAGE_MB} MB",
        "Battery level is greater than ${MIN_BATTERY_PERCENT}%"
      ],
      "steps": [
        {
          "step": 1,
          "action": "Open ${CAMERA_TEST_APP}"
        },
        {
          "step": 2,
          "action": "Select camera ${REAR_PRIMARY_CAMERA_ID}"
        },
        {
          "step": 3,
          "action": "Configure photo resolution ${REAR_PRIMARY_PHOTO_RESOLUTION}"
        },
        {
          "step": 4,
          "action": "Configure image format ${DEFAULT_IMAGE_FORMAT}"
        },
        {
          "step": 5,
          "action": "Start camera preview"
        },
        {
          "step": 6,
          "action": "Capture one photo"
        },
        {
          "step": 7,
          "action": "Wait for image callback and save completion"
        },
        {
          "step": 8,
          "action": "Validate generated image file"
        }
      ],
      "expected_results": [
        "Camera opens successfully",
        "Preview starts successfully",
        "Capture request completes without camera error",
        "Image callback is received",
        "Image file is created",
        "Saved image resolution matches ${REAR_PRIMARY_PHOTO_RESOLUTION}",
        "Saved image format matches ${DEFAULT_IMAGE_FORMAT}"
      ],
      "evidence": [
        "camera_event_log",
        "captured_image",
        "camera_metadata",
        "logcat"
      ],
      "ui_id": "cam_fun_001",
      "source_id": "TC_CAM_FUNC_001"
    },
