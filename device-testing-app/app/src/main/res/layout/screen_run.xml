<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/run_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/brand"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/run_case"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/ink"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/run_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/run_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Waiting for camera…"
        android:textColor="@color/ink"
        android:textSize="14sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:background="#111111">

        <TextureView
            android:id="@+id/run_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/run_preview_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Live preview"
            android:textColor="@color/muted"
            android:textSize="13sp" />
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Last capture"
        android:textColor="@color/muted"
        android:textSize="12sp" />

    <ImageView
        android:id="@+id/run_last_shot"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginTop="6dp"
        android:background="#1A1A1A"
        android:contentDescription="Last captured photo"
        android:scaleType="centerCrop" />

    <Button
        android:id="@+id/run_stop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_test_all"
        android:text="Stop"
        android:textAllCaps="false"
        android:textColor="#FFFFFF" />
</LinearLayout>
